# SPA (React, rutas por path) en Apache/Hostinger.
# Sirve index.html para cualquier ruta que no sea un archivo/carpeta real,
# así /login, /alta, /c/:slug/reservar, etc. cargan la app.
DirectoryIndex index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Lo que vive bajo /assets NUNCA cae en index.html (portado de RDV): si un
  # archivo con hash ya no existe, debe ser 404, no el HTML — el service worker
  # cachearía HTML como si fuera JS y la app quedaría rota hasta limpiar caché.
  RewriteRule ^assets/ - [L]
  # Si el archivo o carpeta existe, se sirve tal cual (assets, manifest, sw, etc.).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Cualquier otra ruta → index.html (la app resuelve el routing en el cliente).
  RewriteRule ^ index.html [L]
</IfModule>

AddType application/manifest+json .webmanifest
AddType application/javascript .js

# Caché (portado de RDV): el HTML, el manifest y el service worker NUNCA se
# cachean (así una versión nueva llega en el siguiente recargo); los assets con
# hash en el nombre son inmutables y pueden vivir un año en caché.
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|registerSW\.js|manifest\.webmanifest|index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable" env=!no_cache
  </FilesMatch>
  <FilesMatch "^(sw\.js|registerSW\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # AUD-015: headers de seguridad. Los "enforced" son inofensivos (no rompen la app).
  # La CSP va en modo Report-Only a propósito: NO bloquea nada, solo reporta en la consola
  # del navegador. Cuando confirmemos que no hay violaciones, se cambia a "Content-Security-Policy".
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co; manifest-src 'self'; worker-src 'self'; base-uri 'self'; frame-ancestors 'self'"
</IfModule>

# Nunca servir metadatos de git si alguna vez llegaran al hosting.
RedirectMatch 404 /\.git
